    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  CASE\n    WHEN NULLIF(TRIM('{{ $json.Email || \"\" }}'), '') IS NOT NULL\n      THEN 'email'\n    WHEN NULLIF(TRIM('{{ $json.Phone || \"\" }}'), '') IS NOT NULL\n      THEN 'phone'\n    ELSE 'name_city'\n  END AS match_type,\n\n  COUNT(*) AS existing_count\n\nFROM people\n\nWHERE\n  (\n    NULLIF(TRIM('{{ $json.Email || \"\" }}'), '') IS NOT NULL\n    AND LOWER(TRIM(email)) = LOWER(TRIM('{{ $json.Email || \"\" }}'))\n  )\n\n  OR\n\n  (\n    NULLIF(TRIM('{{ $json.Email || \"\" }}'), '') IS NULL\n    AND NULLIF(TRIM('{{ $json.Phone || \"\" }}'), '') IS NOT NULL\n    AND REPLACE(REPLACE(REPLACE(phone, ' ', ''), '+91', ''), '-', '')\n        =\n        REPLACE(REPLACE(REPLACE('{{ $json.Phone || \"\" }}', ' ', ''), '+91', ''), '-', '')\n  )\n\n  OR\n\n  (\n    NULLIF(TRIM('{{ $json.Email || \"\" }}'), '') IS NULL\n    AND NULLIF(TRIM('{{ $json.Phone || \"\" }}'), '') IS NULL\n    AND LOWER(TRIM(name)) = LOWER(TRIM('{{ $json.Full_Name || \"\" }}'))\n    AND LOWER(TRIM(city)) = LOWER(TRIM('{{ $json.City || \"\" }}'))\n  );",
        "options": {}
      },
